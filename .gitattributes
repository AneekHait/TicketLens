# Normalise line endings so a contributor on Linux/macOS does not produce a diff
# that touches every line of a file.
* text=auto

# Windows launchers must keep CRLF: cmd.exe mis-parses an LF-only .bat, and
# PowerShell 5.1 is happiest with CRLF. (These files must also stay pure ASCII --
# PS 5.1 reads .ps1 as ANSI when there is no BOM.)
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Shell scripts MUST be LF even when checked out on Windows: a CRLF shebang
# makes Linux fail with "bad interpreter: /usr/bin/env bash^M", which reads like
# a missing bash rather than a line-ending problem.
*.sh    text eol=lf

# Everything else is LF in the repo, whatever the checkout does locally.
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.svg   text eol=lf
*.ini   text eol=lf

# Binary: never touch these.
*.whl   binary
*.gguf  binary
*.npy   binary
*.xlsx  binary
*.png   binary
*.ico   binary
